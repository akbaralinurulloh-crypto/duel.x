# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase project URL, e.g. https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Public anon / publishable key (safe for the browser; protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Add ONLY if a server task truly needs it (not used yet).
# Never prefix with NEXT_PUBLIC_ and never expose to the browser.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional. Public origin used in auth email links (no trailing slash).
# If empty, it is derived from the request. Must be allow-listed in Supabase.
NEXT_PUBLIC_SITE_URL=
